#Generate Index
module load star/2.7.10b-m3zkpic

mkdir -p STAR_index

STAR \
  --runThreadN 4 \
  --runMode genomeGenerate \
  --genomeDir STAR_index \
  --genomeFastaFiles GCF_000001215.4_Release_6_plus_ISO1_MT_genomic.fa  \
  --sjdbGTFfile GCF_000001215.4_Release_6_plus_ISO1_MT_genomic.gtf \
  --sjdbOverhang 50

REF=../STAR_Index/
OUT=../outdir/
IN=../input/


mkdir -p "$OUT"

for file in "$IN"/*.fastq.gz
do
    base=$(basename "$file" .fastq.gz)

    STAR \
        --runThreadN "$SLURM_CPUS_PER_TASK" \
        --twopassMode Basic \
        --outSAMtype BAM SortedByCoordinate \
        --genomeDir "$REF" \
        --readFilesCommand zcat \
        --readFilesIn "$file" \
        --quantMode GeneCounts \
        --outFileNamePrefix "${OUT}/${base}."
done
